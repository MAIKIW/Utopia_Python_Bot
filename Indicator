// @version=5
indicator("UTOPIA_Entry_Zone (Final Fix)", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// -------------------------------------------------------------------------
// 1. SETTINGS INPUTS
// -------------------------------------------------------------------------

grp_show = "ON/OFF Settings"
show_ms      = input.bool(true, "Show Market Structure (ChoCH/BOS)", group=grp_show)
show_ob      = input.bool(true, "Show Order Block [OB]", group=grp_show)
show_sd      = input.bool(true, "Show Demand & Supply [Zones]", group=grp_show)
show_ch      = input.bool(true, "Show High/Low Channel [Line]", group=grp_show)
show_trend   = input.bool(true, "Show Trend-Area [Area]", group=grp_show)
show_ma1     = input.bool(true, "Show Moving Average (1) [Line]", group=grp_show)
show_ma2     = input.bool(true, "Show Moving Average (2) [Line]", group=grp_show)
show_sig     = input.bool(true, "Show Buy-Sell [Signal]", group=grp_show)
show_tb      = input.bool(true, "Show Top-Bottom [Signal]", group=grp_show)

grp_ord = "Order History Function"
show_curr    = input.bool(true, "Show Current Order [Line/Label]", group=grp_ord)
show_stat    = input.bool(true, "Show Statistics Table", group=grp_ord)
stat_mode    = input.string("All History", "Backtest Mode", options=["All History", "Today Only"], group=grp_ord)

grp_tbl = "Table Settings"
tbl_pos_in   = input.string("Top Right", "Panel Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group=grp_tbl)
tbl_size_in  = input.string("Small", "Text Size", options=["Tiny", "Small", "Normal", "Large"], group=grp_tbl)

// Table Color Settings
grp_style = "Table Color & Style"
c_tbl_bg     = input.color(color.new(color.black, 20), "Dashboard Background", group=grp_style)
c_tbl_border = input.color(color.gray, "Dashboard Border", group=grp_style)
c_tbl_text   = input.color(color.white, "Dashboard Text", group=grp_style)

c_stat_head  = input.color(color.new(#4a148c, 0), "Stats Header Color", group=grp_style)
c_stat_bg    = input.color(color.new(#1a1a2e, 10), "Stats Body Color", group=grp_style)
c_stat_text  = input.color(color.white, "Stats Text Color", group=grp_style)

grp_smc = "Demand/Supply & OrderBlock Settings"
c_ob_bear_un = input.color(color.new(color.red, 60), "Bearish OB Color", group=grp_smc)
c_ob_bull_un = input.color(color.new(color.green, 60), "Bullish OB Color", group=grp_smc)
c_sup        = input.color(color.new(color.orange, 50), "Supply Zone Color", group=grp_smc)
c_dem        = input.color(color.new(color.lime, 50), "Demand Zone Color", group=grp_smc)

grp_ma = "Moving Average Setting"
c_ma1        = input.color(color.new(color.yellow, 0), "Color First MA", group=grp_ma)
len_ma1      = input.int(50, "Length First", group=grp_ma)
c_ma2        = input.color(color.new(color.white, 0), "Color Second MA", group=grp_ma)
len_ma2      = input.int(100, "Length Second", group=grp_ma)
c_uptrend    = input.color(color.new(color.green, 80), "Uptrend Area", group=grp_ma)
c_dntrend    = input.color(color.new(color.red, 80), "Downtrend Area", group=grp_ma)

grp_ch = "High/Low Channel Setting"
len_linreg   = input.int(200, "Period", group=grp_ch)
mult_ch      = input.float(2.0, "Multiplier", group=grp_ch)
c_ch         = input.color(color.new(color.gray, 50), "Color Line Channel", group=grp_ch)

grp_tpsl = "TP / SL Setting"
atr_len      = input.int(50, "ATR Length", group=grp_tpsl)
fac_tp1      = input.float(1.5, "Factor TP1", group=grp_tpsl)
fac_tp2      = input.float(3.0, "Factor TP2", group=grp_tpsl)
fac_tp3      = input.float(4.5, "Factor TP3", group=grp_tpsl)
fac_sl       = input.float(3.0, "Factor SL", group=grp_tpsl)
c_tp_line    = input.color(color.green, "Color TP Line", group=grp_tpsl)
c_sl_line    = input.color(color.red, "Color SL Line", group=grp_tpsl)
c_ent_line   = input.color(color.blue, "Color Entry Line", group=grp_tpsl)

grp_col = "Color Signal Setting"
c_buy        = input.color(color.green, "Color Buy Signal", group=grp_col)
c_sell       = input.color(color.red, "Color Sell Signal", group=grp_col)
c_tb         = input.color(color.orange, "Color Top/Bottom Signal", group=grp_col)

// -------------------------------------------------------------------------
// 2. CALCULATIONS & LOGIC
// -------------------------------------------------------------------------

// --- Trend ---
ma1 = ta.ema(close, len_ma1)
ma2 = ta.ema(close, len_ma2)
trendUp = ma1 > ma2
trendDown = ma1 < ma2

fillColor = trendUp ? c_uptrend : (trendDown ? c_dntrend : na)
p1 = plot(show_trend ? ma1 : na, display=display.none)
p2 = plot(show_trend ? ma2 : na, display=display.none)
fill(p1, p2, color=show_trend ? fillColor : na, title="Trend Area")
plot(show_ma1 ? ma1 : na, "MA 1", color=c_ma1)
plot(show_ma2 ? ma2 : na, "MA 2", color=c_ma2)

// --- Signals ---
buySig = ta.crossover(ma1, ma2)
sellSig = ta.crossunder(ma1, ma2)

plotshape(show_sig and buySig, title="Buy", style=shape.labelup, location=location.belowbar, color=c_buy, text="BUY", textcolor=color.white, size=size.small)
plotshape(show_sig and sellSig, title="Sell", style=shape.labeldown, location=location.abovebar, color=c_sell, text="SELL", textcolor=color.white, size=size.small)

// --- Top/Bottom ---
ph = ta.pivothigh(high, 5, 5)
pl = ta.pivotlow(low, 5, 5)
ph_exists = not na(ph)
pl_exists = not na(pl)

plotshape(show_tb and ph_exists ? ph : na, style=shape.triangledown, location=location.abovebar, color=c_tb, offset=-5, size=size.tiny, title="Top")
plotshape(show_tb and pl_exists ? pl : na, style=shape.triangleup, location=location.belowbar, color=c_tb, offset=-5, size=size.tiny, title="Bottom")

// --- Channel ---
linreg = ta.linreg(close, len_linreg, 0)
dev = ta.stdev(close, len_linreg) * mult_ch
upper_ch = linreg + dev
lower_ch = linreg - dev
plot(show_ch ? upper_ch : na, "High Channel", color=c_ch)
plot(show_ch ? lower_ch : na, "Low Channel", color=c_ch)

// -------------------------------------------------------------------------
// 3. ORDER BLOCK & ZONES
// -------------------------------------------------------------------------

// Order Blocks
if show_ob and ph_exists
    if close[5] > open[5] 
        box.new(bar_index[5], high[5], bar_index + 30, low[5], border_color=na, bgcolor=c_ob_bear_un, text="Bearish OB", text_color=color.white, text_size=size.tiny, text_halign=text.align_center, text_valign=text.align_center)

if show_ob and pl_exists
    if close[5] < open[5]
        box.new(bar_index[5], high[5], bar_index + 30, low[5], border_color=na, bgcolor=c_ob_bull_un, text="Bullish OB", text_color=color.white, text_size=size.tiny, text_halign=text.align_center, text_valign=text.align_center)

// Supply / Demand (High Quality Filter)
bodySize = math.abs(close - open)
prevBody = math.abs(close[1] - open[1])
atrVal   = ta.atr(14)
isStrongMove = bodySize > (prevBody * 1.2)
isSignificant = bodySize > (atrVal * 0.5)

isEngulfBear = close < open and close < low[1] and open >= close[1]
if show_sd and isEngulfBear and trendDown and isStrongMove and isSignificant
    box.new(bar_index[1], high[1], bar_index + 25, low[1], border_color=na, bgcolor=c_sup, text="Strong Supply", text_color=color.white, text_size=size.tiny, text_halign=text.align_center, text_valign=text.align_center)

isEngulfBull = close > open and close > high[1] and open <= close[1]
if show_sd and isEngulfBull and trendUp and isStrongMove and isSignificant
    box.new(bar_index[1], high[1], bar_index + 25, low[1], border_color=na, bgcolor=c_dem, text="Strong Demand", text_color=color.white, text_size=size.tiny, text_halign=text.align_center, text_valign=text.align_center)

// Market Structure
prev_high_val = ta.valuewhen(ph_exists, high[5], 0)
prev_low_val = ta.valuewhen(pl_exists, low[5], 0)
isBosUp = ta.crossover(close, prev_high_val)
isBosDn = ta.crossunder(close, prev_low_val)
plotshape(show_ms and isBosUp, "BOS Up", shape.circle, location.abovebar, color.green, size=size.tiny)
plotshape(show_ms and isBosDn, "BOS Down", shape.circle, location.belowbar, color.red, size=size.tiny)

// -------------------------------------------------------------------------
// 4. BACKTEST SIMULATION LOGIC
// -------------------------------------------------------------------------

var int stat_total = 0
var int stat_win = 0
var int stat_lose = 0
var float stat_point_net = 0.0

var int stat_hit_tp1 = 0
var int stat_hit_tp2 = 0
var int stat_hit_tp3 = 0

var int bt_state = 0
var float bt_entry = 0.0
var float bt_sl = 0.0
var float bt_tp1 = 0.0
var float bt_tp2 = 0.0
var float bt_tp3 = 0.0

var bool cur_hit_tp1 = false
var bool cur_hit_tp2 = false

// Daily Reset Logic
isNewDay = ta.change(time("D"))
if stat_mode == "Today Only" and isNewDay
    stat_total := 0
    stat_win := 0
    stat_lose := 0
    stat_point_net := 0.0
    stat_hit_tp1 := 0
    stat_hit_tp2 := 0
    stat_hit_tp3 := 0

atr_bt = ta.atr(atr_len)

// Exit Logic
if bt_state == 1
    if high >= bt_tp1 and not cur_hit_tp1
        cur_hit_tp1 := true
    if high >= bt_tp2 and not cur_hit_tp2
        cur_hit_tp2 := true
        
    if high >= bt_tp3
        stat_win += 1
        stat_total += 1
        stat_hit_tp3 += 1
        stat_hit_tp2 += 1
        stat_hit_tp1 += 1
        stat_point_net += (bt_tp3 - bt_entry)
        bt_state := 0
    else if low <= bt_sl
        stat_lose += 1
        stat_total += 1
        stat_point_net -= (bt_entry - bt_sl)
        if cur_hit_tp1
            stat_hit_tp1 += 1
        if cur_hit_tp2
            stat_hit_tp2 += 1
        bt_state := 0

if bt_state == -1
    if low <= bt_tp1 and not cur_hit_tp1
        cur_hit_tp1 := true
    if low <= bt_tp2 and not cur_hit_tp2
        cur_hit_tp2 := true
        
    if low <= bt_tp3
        stat_win += 1
        stat_total += 1
        stat_hit_tp3 += 1
        stat_hit_tp2 += 1
        stat_hit_tp1 += 1
        stat_point_net += (bt_entry - bt_tp3)
        bt_state := 0
    else if high >= bt_sl
        stat_lose += 1
        stat_total += 1
        stat_point_net -= (bt_sl - bt_entry)
        if cur_hit_tp1
            stat_hit_tp1 += 1
        if cur_hit_tp2
            stat_hit_tp2 += 1
        bt_state := 0

// Entry Logic
if buySig and bt_state == 0
    bt_state := 1
    bt_entry := close
    bt_tp1 := close + (atr_bt * fac_tp1)
    bt_tp2 := close + (atr_bt * fac_tp2)
    bt_tp3 := close + (atr_bt * fac_tp3)
    bt_sl := close - (atr_bt * fac_sl)
    cur_hit_tp1 := false
    cur_hit_tp2 := false

if sellSig and bt_state == 0
    bt_state := -1
    bt_entry := close
    bt_tp1 := close - (atr_bt * fac_tp1)
    bt_tp2 := close - (atr_bt * fac_tp2)
    bt_tp3 := close - (atr_bt * fac_tp3)
    bt_sl := close + (atr_bt * fac_sl)
    cur_hit_tp1 := false
    cur_hit_tp2 := false


// -------------------------------------------------------------------------
// 5. REAL-TIME TP/SL & DASHBOARD LOGIC
// -------------------------------------------------------------------------

atr = ta.atr(atr_len)

var float entry_p = na
var float sl_p = na
var float tp1_p = na
var float tp2_p = na
var float tp3_p = na
var string direction = "Close"

if direction == "Long"
    if high >= tp3_p or low <= sl_p
        direction := "Close"
        entry_p := na
        tp1_p := na
        tp2_p := na
        tp3_p := na
        sl_p := na

if direction == "Short"
    if low <= tp3_p or high >= sl_p
        direction := "Close"
        entry_p := na
        tp1_p := na
        tp2_p := na
        tp3_p := na
        sl_p := na

if buySig
    direction := "Long"
    entry_p := close
    sl_p := entry_p - (atr * fac_sl)
    tp1_p := entry_p + (atr * fac_tp1)
    tp2_p := entry_p + (atr * fac_tp2)
    tp3_p := entry_p + (atr * fac_tp3)

if sellSig
    direction := "Short"
    entry_p := close
    sl_p := entry_p + (atr * fac_sl)
    tp1_p := entry_p - (atr * fac_tp1)
    tp2_p := entry_p - (atr * fac_tp2)
    tp3_p := entry_p - (atr * fac_tp3)

var line l_ent = na
var line l_sl = na
var line l_tp1 = na
var line l_tp2 = na
var line l_tp3 = na

if (buySig or sellSig) and show_curr
    line.delete(l_ent)
    line.delete(l_sl)
    line.delete(l_tp1)
    line.delete(l_tp2)
    line.delete(l_tp3)
    int end_x = bar_index + 10
    l_ent := line.new(bar_index, entry_p, end_x, entry_p, color=c_ent_line, style=line.style_solid)
    l_sl := line.new(bar_index, sl_p, end_x, sl_p, color=c_sl_line, style=line.style_solid)
    l_tp1 := line.new(bar_index, tp1_p, end_x, tp1_p, color=c_tp_line, style=line.style_dashed)
    l_tp2 := line.new(bar_index, tp2_p, end_x, tp2_p, color=c_tp_line, style=line.style_dashed)
    l_tp3 := line.new(bar_index, tp3_p, end_x, tp3_p, color=c_tp_line, style=line.style_dashed)

if not (buySig or sellSig) and show_curr and not na(l_ent) and direction != "Close"
    line.set_x2(l_ent, bar_index + 5)
    line.set_x2(l_sl, bar_index + 5)
    line.set_x2(l_tp1, bar_index + 5)
    line.set_x2(l_tp2, bar_index + 5)
    line.set_x2(l_tp3, bar_index + 5)

// -------------------------------------------------------------------------
// 6. DASHBOARD & STATS TABLE
// -------------------------------------------------------------------------
tbl_pos = tbl_pos_in == "Top Left" ? position.top_left : tbl_pos_in == "Bottom Right" ? position.bottom_right : tbl_pos_in == "Bottom Left" ? position.bottom_left : tbl_pos_in == "Middle Right" ? position.middle_right : position.top_right
tbl_sz = tbl_size_in == "Tiny" ? size.tiny : tbl_size_in == "Normal" ? size.normal : tbl_size_in == "Large" ? size.large : size.small

// --- Table 1: Current Status ---
var tbl = table.new(tbl_pos, 2, 7, border_width=1, frame_color=c_tbl_border, border_color=c_tbl_border, bgcolor=c_tbl_bg)

if barstate.islast
    headerBg = direction == "Long" ? c_buy : (direction == "Short" ? c_sell : color.gray)
    table.cell(tbl, 0, 0, direction, text_color=color.white, bgcolor=headerBg, text_size=tbl_sz)
    table.cell(tbl, 1, 0, "Price", text_color=color.white, bgcolor=headerBg, text_size=tbl_sz)
    
    string t_ent = na(entry_p) ? "-" : str.tostring(entry_p, format.mintick)
    string t_tp1 = na(tp1_p) ? "-" : str.tostring(tp1_p, format.mintick)
    string t_tp2 = na(tp2_p) ? "-" : str.tostring(tp2_p, format.mintick)
    string t_tp3 = na(tp3_p) ? "-" : str.tostring(tp3_p, format.mintick)
    string t_sl  = na(sl_p) ? "-" : str.tostring(sl_p, format.mintick)
    
    table.cell(tbl, 0, 1, "Entry", text_color=c_tbl_text, text_size=tbl_sz)
    table.cell(tbl, 1, 1, t_ent, text_color=c_tbl_text, text_size=tbl_sz)
    table.cell(tbl, 0, 2, "TP 1", text_color=c_tp_line, text_size=tbl_sz)
    table.cell(tbl, 1, 2, t_tp1, text_color=c_tp_line, text_size=tbl_sz)
    table.cell(tbl, 0, 3, "TP 2", text_color=c_tp_line, text_size=tbl_sz)
    table.cell(tbl, 1, 3, t_tp2, text_color=c_tp_line, text_size=tbl_sz)
    table.cell(tbl, 0, 4, "TP 3", text_color=c_tp_line, text_size=tbl_sz)
    table.cell(tbl, 1, 4, t_tp3, text_color=c_tp_line, text_size=tbl_sz)
    table.cell(tbl, 0, 5, "SL", text_color=c_sl_line, text_size=tbl_sz)
    table.cell(tbl, 1, 5, t_sl, text_color=c_sl_line, text_size=tbl_sz)
    
    statusTxt = trendUp ? "UPTREND" : "DOWNTREND"
    statusCol = trendUp ? color.green : color.red
    table.cell(tbl, 0, 6, "Trend", text_color=c_tbl_text, text_size=tbl_sz)
    table.cell(tbl, 1, 6, statusTxt, text_color=statusCol, text_size=tbl_sz)

// --- Table 2: Statistics ---
var tbl_stat = table.new(position.bottom_right, 2, 8, border_width=1, frame_color=c_stat_head, border_color=color.white, bgcolor=c_stat_bg)

if barstate.islast and show_stat
    string head_txt = stat_mode == "Today Only" ? "STATS (TODAY)" : "STATS (ALL)"
    
    table.cell(tbl_stat, 0, 0, "SUMMARY", text_color=c_stat_text, bgcolor=c_stat_head, text_size=size.small)
    table.cell(tbl_stat, 1, 0, head_txt, text_color=c_stat_text, bgcolor=c_stat_head, text_size=size.small)
    
    table.cell(tbl_stat, 0, 1, "TOTAL TRADE", text_color=c_stat_text, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl_stat, 1, 1, str.tostring(stat_total), text_color=c_stat_text, text_size=size.small)
    
    table.cell(tbl_stat, 0, 2, "Hit TP1", text_color=color.new(color.green, 30), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl_stat, 1, 2, str.tostring(stat_hit_tp1), text_color=color.new(color.green, 30), text_size=size.small)

    table.cell(tbl_stat, 0, 3, "Hit TP2", text_color=color.new(color.green, 10), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl_stat, 1, 3, str.tostring(stat_hit_tp2), text_color=color.new(color.green, 10), text_size=size.small)

    table.cell(tbl_stat, 0, 4, "Hit TP3 (Full)", text_color=color.green, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl_stat, 1, 4, str.tostring(stat_hit_tp3), text_color=color.green, text_size=size.small)
    
    table.cell(tbl_stat, 0, 5, "LOSE (Full SL)", text_color=color.red, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl_stat, 1, 5, str.tostring(stat_lose), text_color=color.red, text_size=size.small)
    
    float wr = stat_total > 0 ? (stat_hit_tp3 / stat_total) * 100 : 0.0
    table.cell(tbl_stat, 0, 6, "WINRATE (TP3)", text_color=color.yellow, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl_stat, 1, 6, str.tostring(wr, "#.##") + "%", text_color=color.yellow, text_size=size.small)
    
    table.cell(tbl_stat, 0, 7, "TOTAL POINTS", text_color=stat_point_net >= 0 ? color.green : color.red, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl_stat, 1, 7, str.tostring(stat_point_net, "#.##"), text_color=stat_point_net >= 0 ? color.green : color.red, text_size=size.small)

// -------------------------------------------------------------------------
// 7. ALERTS
// -------------------------------------------------------------------------
alertcondition(buySig, title="Only Buy Signal", message="Buy Signal Detected")
alertcondition(sellSig, title="Only Sell Signal", message="Sell Signal Detected")
alertcondition(ph_exists, title="Only Top Signal", message="Top Structure Formed")
alertcondition(pl_exists, title="Only Bottom Signal", message="Bottom Structure Formed")
alertcondition(ph_exists or pl_exists, title="Market Structure Alert", message="Market Structure Pivot Detected")
alertcondition(ta.crossover(ma1, ma2), title="Trend Change: Uptrend", message="Trend Changed to Uptrend")
alertcondition(ta.crossunder(ma1, ma2), title="Trend Change: Downtrend", message="Trend Changed to Downtrend")
